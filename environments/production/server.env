# BeeAX CRM — beeax-server config · PRODUCTION
# Load as a Kubernetes Secret in the beeax-production namespace (see environments/README.md).
# NEVER commit real secrets — manage them via a Secret store / sealed-secrets / cloud KMS.

NODE_ENV=production

# Data stores — managed, highly-available Postgres/Redis
PG_DATABASE_URL=postgres://beeax:REPLACE_ME@beeax-prod-db:5432/beeax
REDIS_URL=redis://beeax-prod-redis:6379

# Secrets (REQUIRED — generate strong unique values, store in a secret manager)
APP_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# URLs
FRONTEND_URL=https://app.beeax.app
SERVER_URL=https://api.beeax.app

# Behaviour — locked down for production
SIGN_IN_PREFILLED=false
IS_MULTIWORKSPACE_ENABLED=true
IS_EMAIL_VERIFICATION_REQUIRED=true
AUTH_PASSWORD_ENABLED=true
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

# Email
EMAIL_DRIVER=SMTP
EMAIL_FROM_ADDRESS=no-reply@beeax.app
EMAIL_FROM_NAME='BeeAX'
EMAIL_SMTP_HOST=REPLACE_ME
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=REPLACE_ME
EMAIL_SMTP_PASSWORD=REPLACE_ME

# Storage — S3
STORAGE_TYPE=s3
STORAGE_S3_REGION=REPLACE_ME
STORAGE_S3_NAME=beeax-prod-assets

# Rate limiting
API_RATE_LIMITING_TTL=60
API_RATE_LIMITING_LIMIT=1000

# Observability
LOG_LEVELS=error,warn
EXCEPTION_HANDLER_DRIVER=sentry
SENTRY_ENVIRONMENT=production
# SENTRY_DSN=
