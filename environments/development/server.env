# BeeAX CRM — beeax-server config · DEVELOPMENT
# For local dev, copy this to packages/beeax-server/.env (or run setup-dev-env.sh).
# For a dev k8s namespace, load these as a Secret (see environments/README.md).

NODE_ENV=development

# Data stores (local defaults; in-cluster services for the dev namespace)
PG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/default
REDIS_URL=redis://localhost:6379

# Secrets — fine to use a dev placeholder locally; use a real Secret in-cluster
APP_SECRET=dev_only_replace_me_with_a_random_string

# URLs
FRONTEND_URL=http://localhost:3001
SERVER_URL=http://localhost:3000

# Dev conveniences
SIGN_IN_PREFILLED=true
IS_MULTIWORKSPACE_ENABLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
IS_EMAIL_VERIFICATION_REQUIRED=false
AUTH_PASSWORD_ENABLED=true

# Observability
LOG_LEVELS=error,warn,log,debug
EXCEPTION_HANDLER_DRIVER=console
EMAIL_DRIVER=LOGGER
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage
