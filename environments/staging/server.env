# BeeAX CRM — beeax-server config · STAGING
# Load as a Kubernetes Secret in the beeax-staging namespace (see environments/README.md).
# NEVER commit real secrets — the REPLACE_ME values are placeholders.

NODE_ENV=production

# Data stores — point at managed staging Postgres/Redis
PG_DATABASE_URL=postgres://beeax:REPLACE_ME@beeax-staging-db:5432/beeax
REDIS_URL=redis://beeax-staging-redis:6379

# Secrets (use a real Secret store / sealed-secrets, not this file)
APP_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# URLs
FRONTEND_URL=https://staging.beeax.app
SERVER_URL=https://staging-api.beeax.app

# Behaviour
SIGN_IN_PREFILLED=false
IS_MULTIWORKSPACE_ENABLED=true
IS_EMAIL_VERIFICATION_REQUIRED=true
AUTH_PASSWORD_ENABLED=true

# Email (real driver in staging)
EMAIL_DRIVER=SMTP
EMAIL_FROM_ADDRESS=no-reply@staging.beeax.app
EMAIL_FROM_NAME='BeeAX (Staging)'
EMAIL_SMTP_HOST=REPLACE_ME
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=REPLACE_ME
EMAIL_SMTP_PASSWORD=REPLACE_ME

# Storage — S3 in staging
STORAGE_TYPE=s3
STORAGE_S3_REGION=REPLACE_ME
STORAGE_S3_NAME=beeax-staging-assets

# Observability
LOG_LEVELS=error,warn,log
EXCEPTION_HANDLER_DRIVER=sentry
SENTRY_ENVIRONMENT=staging
# SENTRY_DSN=
